# Canonical site origin. Feeds canonical links, Open Graph metadata,
# the sitemap and JSON-LD. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://core-x.solutions

# Supabase, for the blog. Read-only: row-level security limits anonymous
# access to published posts, and these are only used in server components,
# so neither value reaches the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
